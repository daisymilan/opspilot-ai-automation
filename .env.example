# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase ---
# For a local instance (`npm run db:start`), the CLI prints these values;
# they're the same on every machine for the local dev stack, so they're
# safe to write here directly rather than leaving blank:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<printed by `npm run db:start`>
#   SUPABASE_SERVICE_ROLE_KEY=<printed by `npm run db:start`>
# For a hosted Supabase project, use Project Settings > API instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-side only, never expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---
# Primary model provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Fallback provider, used when the primary is unavailable or fails.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- n8n ---
# Base URL of the n8n instance orchestrating workflows.
N8N_BASE_URL=http://localhost:5678
# Shared secret used to authenticate webhook calls between n8n and this app.
N8N_WEBHOOK_SECRET=

# --- Observability / misc (added as they become relevant) ---
