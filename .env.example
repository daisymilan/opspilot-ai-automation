# Copy this file to .env.local for LOCAL DEVELOPMENT ONLY.
# Never commit .env.local or any file containing real secrets.
#
# Production values are never set here or in Git — they live in Vercel's
# project environment variables (app), the hosted Supabase project's own
# settings (database/auth), and the production n8n host's own environment
# (workflow secrets). See docs/production-deployment.md for the full
# production environment-variable inventory and where each value is set.
#
# NODE_ENV is not listed below — Next.js/Vercel set it automatically per
# command (dev/build/start); setting it manually in .env.local can cause
# confusing dev-server behavior and should be avoided.

# =============================================================================
# PUBLIC — safe to ship in the browser bundle (NEXT_PUBLIC_* only)
# =============================================================================

# Used to build absolute URLs for metadata/Open Graph tags (see app/layout.tsx).
# In production this is the real deployed URL (Vercel prod domain or a custom
# domain) — never used for anything security-sensitive.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The URL and anon key below are the Supabase CLI's fixed local-development
# defaults — signed with the CLI's built-in demo JWT secret
# ("super-secret-jwt-token-with-at-least-32-characters-long"), identical on
# every unmodified `supabase init` project on every machine, and published
# in Supabase's own docs. They are not usable against any real project and
# are safe to commit here. `npm run db:start` prints the same values.
# For a hosted Supabase project, replace these with Project Settings > API —
# the anon key is a public, RLS-scoped key by design, safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# =============================================================================
# SERVER-ONLY SECRETS — never sent to the browser, never exposed in a client
# component or API response. In production these are set only in Vercel's
# Environment Variables UI (or `vercel env`), scoped to the Production
# environment — never committed, never in workflow JSON.
# =============================================================================

# Service role key: bypasses RLS entirely (lib/supabase/serviceRole.ts, import
# guarded by the `server-only` package so bundling it into client code is a
# build error). Same local-dev-fixed-value reasoning as the anon key above —
# still never put a real hosted/production service role key here.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Real key required — there is no fallback/demo data when this is missing;
# services/ai/providers/claudeProvider.ts fails loudly instead. Get one at
# https://console.anthropic.com/. Never commit a real value.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Business-rule threshold (0-1): AI analyses below this confidence require
# human approval before their recommended action is actionable. See
# services/leads/businessRules.ts.
AI_CONFIDENCE_THRESHOLD=0.7

# Base URL this app calls to trigger the lead-intelligence/document-intelligence
# workflows (same n8n instance serves both).
# Local: `docker compose up -d n8n` serves it at this address.
# Production: the production n8n host's HTTPS URL — see docs/production-deployment.md.
N8N_BASE_URL=http://localhost:5678
N8N_LEAD_WEBHOOK_PATH=/webhook/lead-intelligence
N8N_DOCUMENT_WEBHOOK_PATH=/webhook/document-intelligence

# Business-rule threshold: a document (invoice) whose extracted amount
# exceeds this always requires human approval, regardless of AI confidence
# — the document-intelligence equivalent of leads' always-review-these-
# actions list. See services/documents/businessRules.ts.
DOCUMENT_APPROVAL_AMOUNT_THRESHOLD=1000

# Shared secret authenticating BOTH directions of the app<->n8n webhook
# trust boundary (see docs/lead-intelligence.md#security): this app sends
# it when calling n8n's webhook; n8n's webhook node is configured with a
# matching Header Auth credential; and app/api/leads/[id]/analyze checks it
# on the way back in. Generate a real value locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Never commit a real value — the one below is a placeholder, not a secret.
# Production must use a DIFFERENT, independently generated value from local dev.
N8N_WEBHOOK_SECRET=local-dev-webhook-secret-change-me

# Reserved for a future OpenAI fallback provider (see services/ai/types.ts
# — AIProvider is provider-agnostic). Not implemented yet.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# =============================================================================
# n8n CONTAINER'S OWN ENVIRONMENT — read by the n8n process itself, not by
# this Next.js app. Set on whatever host runs n8n (local: docker-compose.yml's
# env_file; production: that host's own environment/secrets manager), never
# in Vercel.
# =============================================================================

# n8n's own credential-store encryption key. Generate the same way as
# N8N_WEBHOOK_SECRET above. Losing or changing this after workflows are saved
# makes n8n unable to decrypt stored credentials, so keep it stable per
# environment. Never commit it. Production must use its own independently
# generated value, never the local one.
N8N_ENCRYPTION_KEY=

# NOT read as a container env var by the workflows (n8n Cloud blocks
# `$env.*` access inside node expressions by default). How n8n reaches this
# app is instead set as an n8n Variable named APP_BASE_URL (Settings →
# Variables, both locally and on Cloud) — local: Docker Desktop's host
# gateway hostname since n8n runs in Docker but the app runs via `npm run
# dev` on the host (Linux Docker: use your host's LAN IP instead);
# production: the real deployed app URL (e.g. the Vercel production
# domain) — never localhost/host.docker.internal. See
# docs/lead-intelligence.md#local-setup.
