# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase ---
# The URL and anon key below are the Supabase CLI's fixed local-development
# defaults — signed with the CLI's built-in demo JWT secret
# ("super-secret-jwt-token-with-at-least-32-characters-long"), identical on
# every unmodified `supabase init` project on every machine, and published
# in Supabase's own docs. They are not usable against any real project and
# are safe to commit here. `npm run db:start` prints the same values.
# For a hosted Supabase project, replace these with Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Service role key: server-side only, never expose to the client/browser.
# Left blank — not needed by anything in this repo yet (RLS-respecting
# clients only). Get the local value from `npm run db:start` output if a
# later phase needs it. NEVER put a hosted/production service role key here.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ---
# Primary model provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Fallback provider, used when the primary is unavailable or fails.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- n8n ---
# Base URL of the n8n instance orchestrating workflows.
N8N_BASE_URL=http://localhost:5678
# Shared secret used to authenticate webhook calls between n8n and this app.
N8N_WEBHOOK_SECRET=

# --- Observability / misc (added as they become relevant) ---
