# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase ---
# The URL and anon key below are the Supabase CLI's fixed local-development
# defaults — signed with the CLI's built-in demo JWT secret
# ("super-secret-jwt-token-with-at-least-32-characters-long"), identical on
# every unmodified `supabase init` project on every machine, and published
# in Supabase's own docs. They are not usable against any real project and
# are safe to commit here. `npm run db:start` prints the same values.
# For a hosted Supabase project, replace these with Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Service role key: server-side only (lib/supabase/serviceRole.ts, guarded
# with the `server-only` package) — never sent to the browser. Same local-
# dev-fixed-value reasoning as the anon key above; still never use a real
# hosted/production service role key here.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- AI (Phase 2: Lead Intelligence) ---
# Real key required — there is no fallback/demo data when this is missing;
# services/ai/providers/claudeProvider.ts fails loudly instead. Get one at
# https://console.anthropic.com/. Never commit a real value.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Business-rule threshold (0-1): AI analyses below this confidence require
# human approval before their recommended action is actionable. See
# services/leads/businessRules.ts.
AI_CONFIDENCE_THRESHOLD=0.7

# Reserved for a future OpenAI fallback provider (see services/ai/types.ts
# — AIProvider is provider-agnostic). Not implemented in Phase 2.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# --- n8n (Phase 2: Lead Intelligence orchestration) ---
# Base URL this app calls to trigger the lead-intelligence workflow.
# `docker compose up -d n8n` serves it at this address locally.
N8N_BASE_URL=http://localhost:5678
N8N_LEAD_WEBHOOK_PATH=/webhook/lead-intelligence

# Shared secret authenticating BOTH directions of the app<->n8n webhook
# trust boundary (see docs/lead-intelligence.md#security): this app sends
# it when calling n8n's webhook; n8n's webhook node is configured with a
# matching Header Auth credential; and app/api/leads/[id]/analyze checks it
# on the way back in. Generate a real value locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Never commit a real value — the one below is a placeholder, not a secret.
N8N_WEBHOOK_SECRET=local-dev-webhook-secret-change-me

# n8n's own credential-store encryption key. Required by the n8n container
# itself (see docker-compose.yml) — generate the same way as above. Losing
# or changing this after workflows are saved makes n8n unable to decrypt
# stored credentials, so keep it stable per machine. Never commit it.
N8N_ENCRYPTION_KEY=

# How n8n (running in Docker) reaches the Next.js app (running via
# `npm run dev` on the host, not in Docker). Docker Desktop's host gateway
# hostname works for both Windows and macOS; on Linux Docker, use your
# host's LAN IP instead.
APP_BASE_URL=http://host.docker.internal:3000

# --- Observability / misc (added as they become relevant) ---
